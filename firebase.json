{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "functions/**", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/admin", "destination": "/admin/login.html" }
    ]
  },
  "database": {
    "rules": "rules.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs20"
    }
  ]
}
